# Ignore raw Kaggle download caches
**/kaggle_cache/
*.zip
*.tar.gz

# Data and Binaries (Do NOT push huge raw point cloud files)
data/
Backend/data/*
!Backend/data/static_corridor/
!Backend/data/static_corridor/**
!Backend/data/dynamic_corridor/
!Backend/data/dynamic_corridor/**
*.pkl
*.npy
*.npz

# Whitelist bundled 50 static and 70 dynamic sweeps
!Backend/data/static_corridor/velodyne/*.bin
!Backend/data/dynamic_corridor/velodyne/*.bin

# Python Caches & Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Node & Frontend Build Artifacts
node_modules/
Frontend/node_modules/
Frontend/dist/
dist/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Secrets
.env
.env.*
!.env.example
!Frontend/.env*

# OS / IDE Artifacts
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
