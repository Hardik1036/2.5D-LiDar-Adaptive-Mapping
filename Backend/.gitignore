*.npy

# Whitelist bundled 50 static and 70 dynamic sweeps
!data/static_corridor/velodyne/*.bin
!data/dynamic_corridor/velodyne/*.bin
!Backend/data/static_corridor/velodyne/*.bin
!Backend/data/dynamic_corridor/velodyne/*.bin
